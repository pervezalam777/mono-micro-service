# Vite configuration - env variables must be prefixed with VITE_
# API Gateway (preferred for local development)
VITE_API_ALL_URL=http://localhost:4000/api/v1

# Alternative: Direct service URLs (not recommended for local dev)
# VITE_API_AUTH_URL=http://localhost:3000/api/v1
# VITE_API_AUTHOR_URL=http://localhost:3001/api/v1
# VITE_API_BOOK_URL=http://localhost:3002/api/v1
