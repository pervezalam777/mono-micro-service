# Environment Variables for API Gateway

# Server Configuration
PORT=8000
NODE_ENV=development
LOG_LEVEL=info

# CORS Configuration
# Frontend applications run on ports 5173-5179
# Options:
# 1. Default (no value set): Uses regex /http:\/\/localhost:517[3-9]/ for ports 5173-5179
# 2. Single origin: CORS_ORIGIN=http://localhost:5173
# 3. Multiple origins (comma-separated): CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
CORS_ORIGIN=

# Microservice URLs
# Microservices only accept calls from API gateway (port 8000), not directly from frontend
MICROSERVICE_AUTH_URL=http://localhost:3000
MICROSERVICE_AUTHOR_URL=http://localhost:3001
MICROSERVICE_BOOK_URL=http://localhost:3002
